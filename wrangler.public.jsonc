{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stillgood",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "stillgood.fyi", "custom_domain": true },
    { "pattern": "www.stillgood.fyi", "custom_domain": true }
  ],
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stillgood-telemetry",
      "database_id": "8cda3cec-4b3b-4267-b1ac-a81f175639b3",
      "migrations_dir": "drizzle"
    }
  ]
}
