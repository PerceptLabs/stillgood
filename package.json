{
  "name": "stillgood",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:cloudflare": "cross-env STILLGOOD_PUBLIC_CLOUDFLARE=1 vinext build",
    "deploy:cloudflare": "npm run cloudflare:check && npm run build:cloudflare && wrangler deploy",
    "cloudflare:check": "node scripts/check-cloudflare-config.mjs",
    "cloudflare:migrate": "wrangler d1 migrations apply stillgood-telemetry --remote --config wrangler.public.jsonc",
    "start": "vinext start",
    "test": "npm run build && node --import ./tests/register-cloudflare-loader.mjs --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "acorn": "8.18.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
